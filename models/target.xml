<!--
  Target UAV (Role 1).

  A model *fragment* included by scene.xml. The target is a **mocap body**: its motion
  is prescribed kinematically each step from a TargetTrajectory (it is a threat to
  track, not a body the physics integrates), so it cannot be perturbed by contact or
  by the interceptor's wake. The plant writes its world pose into data.mocap_pos /
  data.mocap_quat every step.
-->
<mujoco model="target">
  <worldbody>
    <body name="target" mocap="true" pos="10 0 5">
      <geom name="target_body" type="sphere" size="0.08" rgba="0.85 0.20 0.20 1"
            contype="0" conaffinity="0"/>
      <site name="target_marker" type="box" size="0.10 0.02 0.02" rgba="0.95 0.4 0.1 1"/>
    </body>
  </worldbody>
</mujoco>
